// ============================================================================
// LAYOUT
// ============================================================================
prefer-no-csd

layout {
    gaps 4
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    border {
        off
        width 1
        active-color   "#707070"
        inactive-color "#d0d0d0"
        urgent-color   "#cc4444"
    }

    focus-ring {
        on
        width 1
        active-color   "#808080"
        inactive-color "#505050"
    }

    shadow {
       // off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts { }
}

gestures {
    hot-corners {
        // off
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-when-typing
}

overview {
    zoom 0.75

    // Uncomment to give the overview a solid backdrop between workspaces.
    //backdrop-color "#777777"

    // Uncomment to disable the workspace shadow in the overview.
    //workspace-shadow {
    //    off
    //}
}

// ============================================================================
// WINDOW RULES
// ============================================================================

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Uncomment if you want the change of opacity through active/inactive windows
//window-rule {
//    match is-active=false
//    opacity 0.9
//}

window-rule {
    match app-id="^firefox$" title="^Picture-in-Picture$"

    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}
window-rule {
    //match app-id="foot"

    //
    //opacity 0.8

    background-effect {
        blur true
        xray true
        noise 0.1
    }
}
