animations {
    workspace-switch {
        spring damping-ratio=0.65 stiffness=650 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.6 stiffness=550 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.75 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.65 stiffness=600 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.6 stiffness=650 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.7 stiffness=700 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.55 stiffness=900 epsilon=0.001
    }
    screenshot-ui-open {
        spring damping-ratio=0.65 stiffness=700 epsilon=0.0001
    }
}
